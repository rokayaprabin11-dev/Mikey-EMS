# Copy this file to .env for development. Never commit .env.
# On Computer 1 the server runs with API_HOST=0.0.0.0.
API_HOST=127.0.0.1
API_PORT=3100
TZ=Asia/Kathmandu
DATABASE_URL=postgresql://mikey:mikey@127.0.0.1:5432/mikeyems
# Lets `pnpm db:seed` load the sample school. Never set this on Computer 1.
MIKEY_ALLOW_DEV_SEED=yes
